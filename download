-- Links a client's login to the member row you created, matched by email,
-- the first time they sign in.
create or replace function claim_membership() returns void
language plpgsql security definer set search_path = public as $$
begin
  update members
     set auth_user_id = auth.uid()
   where auth_user_id is null
     and lower(email) = lower((select email from auth.users where id = auth.uid()));
end; $$;

-- Sets a session's status and (optionally) uses up one monthly session.
-- Allowed for you (admin) or the client who owns that session.
create or replace function set_session_status(p_session uuid, p_status text, p_consume boolean)
returns void language plpgsql security definer set search_path = public as $$
declare v_member uuid;
begin
  select member_id into v_member from sessions where id = p_session;
  if v_member is null then raise exception 'session not found'; end if;
  if not (is_admin() or v_member in (select id from members where auth_user_id = auth.uid()))
    then raise exception 'not allowed'; end if;
  update sessions set status = p_status where id = p_session;
  if p_consume then
    update members set sessions_remaining = greatest(0, sessions_remaining - 1) where id = v_member;
  end if;
end; $$;

grant execute on function claim_membership() to authenticated;
grant execute on function set_session_status(uuid, text, boolean) to authenticated;
grant execute on function is_admin() to authenticated;
